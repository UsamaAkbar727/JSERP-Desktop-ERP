{
  "name": "erp-pro-desktop",
  "productName": "JSERP",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "homepage": "https://www.jahasoft.com/erp-pro",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron": "wait-on http://localhost:8080 && cross-env NODE_ENV=development electron .",
    "preelectron": "npm run rebuild && npm run build:electron:dev",
    "electron:dev": "concurrently \"npm run dev\" \"npm run electron\"",
    "electron:dev-reload": "concurrently \"npm run dev\" \"wait-on http://localhost:8080 && cross-env NODE_ENV=development nodemon --exec electron . --watch electron --ext ts,js\"",
    "rebuild": "node scripts/rebuild-native.cjs",
    "build:electron:dev": "cross-env NODE_ENV=development node scripts/build-electron.cjs",
    "build:electron": "cross-env NODE_ENV=production node scripts/build-electron.cjs",
    "build:app": "npm run build && npm run build:electron",
    "dist": "npm run build:app && electron-builder",
    "dist:win": "npm run build:app && electron-builder --win",
    "dist:mac": "npm run build:app && electron-builder --mac",
    "dist:linux": "npm run build:app && electron-builder --linux",
    "build:icons": "node scripts/generate-icons.js",
    "check-db": "node scripts/check-database.cjs",
    "reset-db": "node scripts/reset-database.cjs",
    "prepare-build": "node scripts/prepare-build.cjs",
    "build:production": "cross-env NODE_ENV=production node scripts/build-production.cjs",
    "build:production:win": "cross-env NODE_ENV=production node scripts/build-production.cjs win",
    "build:production:mac": "cross-env NODE_ENV=production node scripts/build-production.cjs mac",
    "build:production:linux": "cross-env NODE_ENV=production node scripts/build-production.cjs linux",
    "build:production:all": "cross-env NODE_ENV=production node scripts/build-production.cjs all",
    "release:workflow": "node scripts/release-workflow.cjs",
    "release:patch": "node scripts/release.cjs patch",
    "release:minor": "node scripts/release.cjs minor",
    "release:major": "node scripts/release.cjs major"
  },
  "dependencies": {
