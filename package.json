    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "csv-stringify": "^6.6.0",
    "date-fns": "^3.6.0",
    "electron-store": "^11.0.2",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "^4.4.0",
    "input-otp": "^1.4.2",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "node-machine-id": "^1.1.12",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
